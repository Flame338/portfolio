---
import { profile } from '../data/portfolio.ts';

interface Props {
  /** Replaces the education line. Pass null to show no note. */
  note?: string | null;
}

const { note = profile.education } = Astro.props;
---

<footer class="site-footer mono">
  {note && <span>{note}</span>}
  <span>{profile.location}</span>
</footer>
