---
import Layout from '../layouts/Layout.astro';

const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<Layout title="Page not found · Steve Thomas" noindex>
  <main id="main" tabindex="-1" class="not-found">
    <h1>Nothing matches that address.</h1>
    <p>The page you asked for is not here.</p>
    <a class="button cell hover-ink" href={home}>Back to the index</a>
  </main>
</Layout>
