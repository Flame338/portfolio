---
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Postings from '../components/Postings.astro';
import Projects from '../components/Projects.astro';
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/portfolio.ts';
import { getEntries } from '../lib/entries.ts';
import { personJsonLd } from '../lib/jsonLd.ts';
import { homePath } from '../lib/paths.ts';

const entries = await getEntries();
const path = homePath(import.meta.env.BASE_URL);
const home = new URL(path, Astro.site).href;
---

<Layout title={`${profile.name} · Software engineer`} path={path} jsonLd={personJsonLd(home)}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero entries={entries} />
    <Postings entries={entries} />
    <Projects />
    <Experience />
    <Contact />
  </main>
  <Footer />
</Layout>
