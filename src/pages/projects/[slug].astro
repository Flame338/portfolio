---
import { render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { profile } from '../../data/portfolio.ts';
import { projectJsonLd } from '../../lib/jsonLd.ts';
import { homePath } from '../../lib/paths.ts';
import { nextProject, projectHref, STATUS_LABEL } from '../../lib/projectModel.ts';
import { getProjects, type LoadedProject } from '../../lib/projects.ts';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: LoadedProject;
}

const { project } = Astro.props;
const { slug, data, meta, entry } = project;

const base = import.meta.env.BASE_URL;
const home = homePath(base);
const path = projectHref(base, slug);
const url = new URL(path, Astro.site).href;

const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
const next = nextProject(await getProjects(), slug);

const status = STATUS_LABEL[data.status];
const lastCommit = meta.lastCommit?.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const footerNote = meta.isSubmodule ? `This page is built from portfolio.md in the ${data.title} repo.` : null;
---

<Layout
  title={`${data.title} · ${profile.name}`}
  description={data.summary}
  path={path}
  jsonLd={projectJsonLd(project, url, new URL(home, Astro.site).href)}
>
  <Header crumb={`/ projects / ${slug}`} />
  <main id="main" tabindex="-1">
    <section aria-labelledby="project-title">
      <div class="project-hero">
        <div class="project-intro">
          <p class="mono">project · {data.language} · {status}</p>
          <h1 id="project-title">{data.title}</h1>
          <p class="lead">{data.line}</p>
        </div>
        <dl class="facts">
          <div class="fact">
            <dt class="mono">language</dt>
            <dd>{data.language}</dd>
          </div>
          <div class="fact">
            <dt class="mono">status</dt>
            <dd>{status[0].toUpperCase() + status.slice(1)}</dd>
          </div>
          {
            meta.lastCommit && lastCommit && (
              <div class="fact">
                <dt class="mono">last commit</dt>
                <dd>
                  <time datetime={meta.lastCommit.toISOString()}>{lastCommit}</time>
                </dd>
              </div>
            )
          }
          {
            meta.isSubmodule && meta.revision && (
              <div class="fact">
                <dt class="mono">shown at</dt>
                <dd class="mono">{meta.revision}</dd>
              </div>
            )
          }
          {
            data.source && (
              <div class="fact fact-link cell">
                <dt>Source</dt>
                <dd>
                  <a href={data.source}>{data.source.replace(/^https?:\/\//, '')}</a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </section>

    {
      data.numbers && data.numbers.length > 0 && (
        <div class="band invert">
          <ul class="stats" style={`--count: ${data.numbers.length}`}>
            {data.numbers.map((number) => (
              <li class="stat">
                <p class="stat-value">{number.value}</p>
                <p class="stat-caption">{number.caption}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <section class="doc-section">
      <div class:list={['doc', toc.length >= 2 && 'has-toc']}>
        {
          toc.length >= 2 && (
            <nav class="toc" aria-label="On this page">
              <p class="toc-label mono">on this page</p>
              <ul>
                {toc.map((heading) => (
                  <li>
                    <a class="mono cell hover-ink" href={`#${heading.slug}`}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <article class="doc-body prose">
          <Content />
        </article>
      </div>
    </section>

    <nav class="band" aria-label="More projects">
      <ul class="project-nav">
        <li>
          <a class="cell hover-ink" href={`${home}#projects`}>
            <span class="mono">back</span>
            <span class="project-nav-title">All projects</span>
          </a>
        </li>
        {
          next && (
            <li>
              <a class="cell hover-ink next" href={projectHref(base, next.slug)}>
                <span class="mono">next</span>
                <span class="project-nav-title">{next.data.title}</span>
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </main>
  <Footer note={footerNote} />
</Layout>
