---
import outfit300 from '@fontsource/outfit/files/outfit-latin-300-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import { profile } from '../data/portfolio.ts';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Site path of this page, including the base. Omit for pages that should not be indexed. */
  path?: string;
  jsonLd?: object | readonly object[];
  noindex?: boolean;
}

const { title, description = profile.description, path, jsonLd = [], noindex = false } = Astro.props;

const canonical = path === undefined ? undefined : new URL(path, Astro.site).href;
const structuredData = Array.isArray(jsonLd) ? jsonLd : [jsonLd];

const favicon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" fill="#0F4D3A"/><g fill="#EFEDE6"><rect x="3" y="3" width="5" height="5"/><rect x="14" y="3" width="5" height="5"/><rect x="8.5" y="8.5" width="5" height="5"/><rect x="3" y="14" width="5" height="5"/><rect x="14" y="14" width="5" height="5"/></g></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EFEDE6" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(favicon)}`} />
    <link rel="preload" href={outfit300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <noscript><style>.finder-control{display:none}</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
